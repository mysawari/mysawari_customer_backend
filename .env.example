# Copy this file to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────
PORT=5001
NODE_ENV=development

# ── Database (MongoDB) ────────────────────────────────────────
MONGO_URI=

# ── Auth: long random strings, different from each other ─────
# Set both in production. (If unset, built-in development defaults are used.)
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Payments (Razorpay) ───────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Review photos (Cloudinary) — or set the single CLOUDINARY_URL instead ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# ── WhatsApp OTP (WATI) ───────────────────────────────────────
WATI_API_URL=
WATI_ACCESS_TOKEN=
WATI_TENANT_ID=
WATI_TEMPLATE_NAME=otp_message

# ── Optional: Google Maps / Photon (location search) ─────────
GOOGLE_MAPS_API_KEY=
PHOTON_BASE_URL=
